{
    "name": "amjadiqbal/laravel-logpulse",
    "description": "Proactive log health monitoring & intelligent alerting for Laravel applications. Catch production issues before your customers do.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "keywords": [
        "laravel",
        "logging",
        "monitoring",
        "alerts",
        "devops",
        "health-check",
        "error-tracking",
        "slack",
        "discord",
        "production-monitoring",
        "log-pulse",
        "amjadiqbal"
    ],
    "authors": [
        {
            "name": "Amjad Iqbal",
            "email": "hi@amjad.com.pk",
            "homepage": "https://amjad.com.pk",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/AmjadIqbal/laravel-logpulse",
    "support": {
        "issues": "https://github.com/amjadiqbal/laravel-logpulse/issues",
        "source": "https://github.com/amjadiqbal/laravel-logpulse",
        "docs": "https://logpulse.amjadiqbal.dev",
        "security": "https://github.com/amjadiqbal/laravel-logpulse/security/policy"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/amjadiqbal"
        },
        {
            "type": "buymeacoffee",
            "url": "https://www.buymeacoffee.com/amjadiqbal"
        }
    ],
    "require": {
        "php": "^8.0|^8.1|^8.2|^8.3|^8.4|^8.5",
        "laravel/framework": "^9.0|^10.0|^11.0|^12.0|^13.0",
        "laravel/prompts": "^0.1.15|^0.2|^0.3",
        "guzzlehttp/guzzle": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^2.0|^3.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "AmjadIqbal\\LogPulse\\": "src/",
            "AmjadIqbal\\LogPulse\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AmjadIqbal\\LogPulse\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        },
        "laravel": {
            "providers": [
                "AmjadIqbal\\LogPulse\\LogPulseServiceProvider"
            ],
            "aliases": {
                "LogPulse": "AmjadIqbal\\LogPulse\\Facades\\LogPulse"
            }
        }
    },
    "scripts": {
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
